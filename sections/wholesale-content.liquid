{%- liquid
  assign st = section.settings
  assign benefit_count = 0
  assign audience_count = 0
  assign process_count = 0
  assign oem_href = st.oem_link

  for block in section.blocks
    case block.type
      when 'benefit'
        assign benefit_count = benefit_count | plus: 1
      when 'audience'
        assign audience_count = audience_count | plus: 1
      when 'process'
        assign process_count = process_count | plus: 1
    endcase
  endfor

  if oem_href == blank
    assign oem_href = '/collections/oem'
  endif
-%}

<section
  id="WholesaleContent-{{ section.id }}"
  class="wholesale-content"
  style="--wholesale-content-bg: {{ st.background_color }}; --wholesale-content-card: {{ st.card_background }}; --wholesale-content-text: {{ st.text_color }}; --wholesale-content-accent: {{ st.accent_color }}; --wholesale-content-padding-top: {{ st.padding_top }}px; --wholesale-content-padding-bottom: {{ st.padding_bottom }}px;"
>
  <div class="container wholesale-content__inner">
    {%- if benefit_count > 0 -%}
      <div class="wholesale-content__group wholesale-content__group--benefits">
        {%- if st.benefits_eyebrow != blank or st.benefits_heading != blank or st.benefits_description != blank -%}
          <header class="wholesale-section__header wholesale-section__header--center">
            {%- if st.benefits_eyebrow != blank -%}
              <p class="wholesale-section__eyebrow">{{ st.benefits_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if st.benefits_heading != blank -%}
              <h2 class="wholesale-section__title">{{ st.benefits_heading | escape }}</h2>
            {%- endif -%}
            {%- if st.benefits_description != blank -%}
              <div class="wholesale-section__description rte">{{ st.benefits_description }}</div>
            {%- endif -%}
          </header>
        {%- endif -%}

        <div class="wholesale-benefits__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'benefit' -%}
              <article class="wholesale-benefit" {{ block.shopify_attributes }}>
                {%- if block.settings.benefit_kicker != blank -%}
                  <span class="wholesale-benefit__kicker">{{ block.settings.benefit_kicker | escape }}</span>
                {%- endif -%}
                <h3 class="wholesale-benefit__title">{{ block.settings.benefit_heading | escape }}</h3>
                <div class="wholesale-benefit__text rte">{{ block.settings.benefit_text }}</div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}

    {%- if st.catalog_heading != blank -%}
      <header class="wholesale-section__header wholesale-section__header--catalog">
        {%- if st.catalog_eyebrow != blank -%}
          <p class="wholesale-section__eyebrow">{{ st.catalog_eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="wholesale-section__title">{{ st.catalog_heading | escape }}</h2>
        {%- if st.catalog_description != blank -%}
          <div class="wholesale-section__description rte">{{ st.catalog_description }}</div>
        {%- endif -%}
      </header>
    {%- endif -%}

    {%- if audience_count > 0 -%}
      <div class="wholesale-business">
        <div class="wholesale-business__media">
          {%- if st.business_image != blank -%}
            {{-
              st.business_image
              | image_url: width: 1400
              | image_tag:
                widths: '480, 750, 1000, 1200, 1400',
                sizes: '(min-width: 990px) 48vw, 100vw',
                loading: 'lazy',
                alt: st.business_image_alt,
                class: 'wholesale-business__image'
            -}}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'wholesale-business__placeholder' }}
          {%- endif -%}
        </div>

        <div class="wholesale-business__content">
          <header class="wholesale-section__header">
            {%- if st.business_eyebrow != blank -%}
              <p class="wholesale-section__eyebrow">{{ st.business_eyebrow | escape }}</p>
            {%- endif -%}
            {%- if st.business_heading != blank -%}
              <h2 class="wholesale-section__title">{{ st.business_heading | escape }}</h2>
            {%- endif -%}
            {%- if st.business_description != blank -%}
              <div class="wholesale-section__description rte">{{ st.business_description }}</div>
            {%- endif -%}
          </header>

          <div class="wholesale-audience__grid">
            {%- for block in section.blocks -%}
              {%- if block.type == 'audience' -%}
                <article class="wholesale-audience" {{ block.shopify_attributes }}>
                  <h3>{{ block.settings.audience_heading | escape }}</h3>
                  <div class="rte">{{ block.settings.audience_text }}</div>
                </article>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    {%- if process_count > 0 -%}
      <div class="wholesale-content__group wholesale-content__group--process">
        <header class="wholesale-section__header wholesale-section__header--center">
          {%- if st.process_eyebrow != blank -%}
            <p class="wholesale-section__eyebrow">{{ st.process_eyebrow | escape }}</p>
          {%- endif -%}
          {%- if st.process_heading != blank -%}
            <h2 class="wholesale-section__title">{{ st.process_heading | escape }}</h2>
          {%- endif -%}
          {%- if st.process_description != blank -%}
            <div class="wholesale-section__description rte">{{ st.process_description }}</div>
          {%- endif -%}
        </header>

        <ol class="wholesale-process__grid">
          {%- for block in section.blocks -%}
            {%- if block.type == 'process' -%}
              <li class="wholesale-process" {{ block.shopify_attributes }}>
                <span class="wholesale-process__step">{{ block.settings.process_step | escape }}</span>
                <h3>{{ block.settings.process_heading | escape }}</h3>
                <div class="rte">{{ block.settings.process_text }}</div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      </div>
    {%- endif -%}

    {%- if st.oem_heading != blank -%}
      <aside class="wholesale-oem" aria-labelledby="WholesaleOemTitle-{{ section.id }}">
        <div class="wholesale-oem__content">
          {%- if st.oem_eyebrow != blank -%}
            <p class="wholesale-section__eyebrow">{{ st.oem_eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="WholesaleOemTitle-{{ section.id }}" class="wholesale-oem__title">
            {{ st.oem_heading | escape }}
          </h2>
          {%- if st.oem_description != blank -%}
            <div class="wholesale-oem__description rte">{{ st.oem_description }}</div>
          {%- endif -%}
        </div>
        {%- if st.oem_button_label != blank -%}
          <a class="button wholesale-oem__button" href="{{ oem_href }}">
            {{ st.oem_button_label | escape }}
          </a>
        {%- endif -%}
      </aside>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .wholesale-content {
    background: var(--wholesale-content-bg, #f8f5f0);
    color: var(--wholesale-content-text, #1a3128);
    padding-top: var(--wholesale-content-padding-top, 80px);
    padding-bottom: var(--wholesale-content-padding-bottom, 80px);
  }

  .wholesale-content__inner {
    display: grid;
    gap: clamp(64px, 8vw, 116px);
  }

  .wholesale-section__header {
    max-width: 720px;
  }

  .wholesale-section__header--center,
  .wholesale-section__header--catalog {
    margin-right: auto;
    margin-left: auto;
    text-align: center;
  }

  .wholesale-section__header--catalog {
    max-width: 780px;
  }

  .wholesale-section__eyebrow {
    margin: 0 0 18px;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .wholesale-section__title {
    margin: 0;
    color: var(--wholesale-content-text, #1a3128);
    font-size: clamp(34px, 4vw, 54px);
    line-height: 1.1;
  }

  .wholesale-section__description {
    margin-top: 18px;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 16px;
    line-height: 1.75;
    opacity: 0.8;
  }

  .wholesale-section__description p,
  .wholesale-benefit__text p,
  .wholesale-audience .rte p,
  .wholesale-process .rte p,
  .wholesale-oem__description p {
    margin: 0;
  }

  .wholesale-benefits__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid rgba(26, 49, 40, 0.2);
    border-bottom: 1px solid rgba(26, 49, 40, 0.2);
    margin-top: 48px;
  }

  .wholesale-benefit {
    min-height: 260px;
    padding: 34px 30px;
    border-left: 1px solid rgba(26, 49, 40, 0.2);
  }

  .wholesale-benefit:first-child {
    border-left: 0;
  }

  .wholesale-benefit__kicker {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border: 1px solid currentColor;
    border-radius: 50%;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .wholesale-benefit__title {
    margin: 40px 0 12px;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 21px;
    line-height: 1.25;
  }

  .wholesale-benefit__text {
    color: var(--wholesale-content-text, #1a3128);
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.74;
  }

  .wholesale-business {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: stretch;
    background: var(--wholesale-content-card, #ffffff);
  }

  .wholesale-business__media {
    min-height: 660px;
    overflow: hidden;
  }

  .wholesale-business__image,
  .wholesale-business__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 660px;
    object-fit: cover;
  }

  .wholesale-business__placeholder {
    background: var(--wholesale-content-accent, #cfddc2);
  }

  .wholesale-business__content {
    align-self: center;
    padding: clamp(44px, 6vw, 88px);
  }

  .wholesale-audience__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin-top: 42px;
  }

  .wholesale-audience {
    padding-top: 24px;
    border-top: 2px solid var(--wholesale-content-accent, #cfddc2);
  }

  .wholesale-audience h3,
  .wholesale-process h3 {
    margin: 0 0 12px;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 20px;
    line-height: 1.3;
  }

  .wholesale-audience .rte,
  .wholesale-process .rte {
    color: var(--wholesale-content-text, #1a3128);
    font-size: 14px;
    line-height: 1.7;
    opacity: 0.74;
  }

  .wholesale-process__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
  }

  .wholesale-process {
    min-height: 270px;
    padding: 34px;
    background: var(--wholesale-content-card, #ffffff);
  }

  .wholesale-process__step {
    display: block;
    margin-bottom: 54px;
    color: var(--wholesale-content-text, #1a3128);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .wholesale-oem {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 36px;
    padding: clamp(38px, 5vw, 64px);
    background: #1a3128;
    color: #ffffff;
  }

  .wholesale-oem__content {
    max-width: 760px;
  }

  .wholesale-oem .wholesale-section__eyebrow,
  .wholesale-oem__title,
  .wholesale-oem__description {
    color: #ffffff;
  }

  .wholesale-oem__title {
    margin: 0;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.12;
  }

  .wholesale-oem__description {
    margin-top: 14px;
    line-height: 1.7;
    opacity: 0.78;
  }

  .wholesale-oem__button {
    flex: 0 0 auto;
    min-height: 52px;
    padding: 14px 24px;
    border: 1px solid #cfddc2;
    border-radius: 0;
    background: #cfddc2;
    color: #1a3128;
    font-weight: 600;
    text-decoration: none;
  }

  .wholesale-oem__button:hover,
  .wholesale-oem__button:focus-visible {
    border-color: #ffffff;
    background: #ffffff;
    color: #1a3128;
  }

  .wholesale-oem__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  @media (max-width: 989px) {
    .wholesale-benefits__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .wholesale-benefit:nth-child(3) {
      border-left: 0;
    }

    .wholesale-benefit:nth-child(n + 3) {
      border-top: 1px solid rgba(26, 49, 40, 0.2);
    }

    .wholesale-business {
      grid-template-columns: 1fr;
    }

    .wholesale-business__media,
    .wholesale-business__image,
    .wholesale-business__placeholder {
      min-height: 520px;
    }

    .wholesale-process__grid {
      grid-template-columns: 1fr;
    }

    .wholesale-process {
      min-height: 0;
    }
  }

  @media (max-width: 749px) {
    .wholesale-content {
      padding-top: min(var(--wholesale-content-padding-top, 80px), 64px);
      padding-bottom: min(var(--wholesale-content-padding-bottom, 80px), 64px);
    }

    .wholesale-content__inner {
      gap: 64px;
    }

    .wholesale-benefits__grid,
    .wholesale-audience__grid {
      grid-template-columns: 1fr;
    }

    .wholesale-benefit,
    .wholesale-benefit:nth-child(3) {
      min-height: 0;
      border-top: 1px solid rgba(26, 49, 40, 0.2);
      border-left: 0;
    }

    .wholesale-benefit:first-child {
      border-top: 0;
    }

    .wholesale-business__media,
    .wholesale-business__image,
    .wholesale-business__placeholder {
      min-height: 380px;
    }

    .wholesale-business__content {
      padding: 42px 24px 48px;
    }

    .wholesale-oem {
      align-items: flex-start;
      flex-direction: column;
    }

    .wholesale-oem__button {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

