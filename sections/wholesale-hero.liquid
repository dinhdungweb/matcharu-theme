{%- liquid
  assign st = section.settings
  assign primary_href = st.primary_link
  assign secondary_href = st.secondary_link
  assign hero_image = st.hero_image | default: st.hero_image_mobile
  assign hero_alt = st.hero_image_alt | default: st.heading
  assign hero_container = st.container | default: 'full-width'
  assign edge_to_edge_split = st.edge_to_edge_split | default: true, allow_false: true
  assign content_padding = st.content_padding | default: 48
  assign content_padding_mobile = st.content_padding_mobile | default: 20
  assign hero_height = st.hero_height | default: 680
  assign image_width = st.image_width | default: 72
  assign content_width = st.content_width | default: 660
  assign image_position = st.image_position | default: 'center center'
  assign canvas_color = st.canvas_color | default: '#f8f5f0'

  if edge_to_edge_split
    assign hero_container = 'full-width'
  endif

  if primary_href == blank
    assign primary_href = '#product-grid'
  endif
  if secondary_href == blank
    assign secondary_href = '#wholesale-inquiry'
  endif
-%}

<section
  class="wholesale-hero"
  style="--wholesale-hero-canvas: {{ canvas_color }}; --wholesale-hero-bg: {{ st.background_color }}; --wholesale-hero-text: {{ st.text_color }}; --wholesale-hero-accent: {{ st.accent_color }}; --wholesale-hero-content-padding: {{ content_padding }}px; --wholesale-hero-content-padding-mobile: {{ content_padding_mobile }}px; --wholesale-hero-height: {{ hero_height }}px; --wholesale-hero-image-width: {{ image_width }}%; --wholesale-hero-content-width: {{ content_width }}px; --wholesale-hero-image-position: {{ image_position }};"
  aria-labelledby="WholesaleHeroTitle-{{ section.id }}"
>
  <div class="{{ hero_container }} section-full wholesale-hero__grid">
    <div class="wholesale-hero__content">
      <div class="wholesale-hero__content-inner">
        {%- if st.eyebrow != blank -%}
          <p class="wholesale-hero__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if st.heading != blank -%}
          <h1 id="WholesaleHeroTitle-{{ section.id }}" class="wholesale-hero__title">
            {{ st.heading | escape }}
          </h1>
        {%- endif -%}

        {%- if st.description != blank -%}
          <div class="wholesale-hero__description rte">{{ st.description }}</div>
        {%- endif -%}

        <div class="wholesale-hero__actions">
          {%- if st.primary_label != blank -%}
            <a class="button wholesale-hero__button wholesale-hero__button--primary" href="{{ primary_href }}">
              {{ st.primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if st.secondary_label != blank -%}
            <a class="button wholesale-hero__button wholesale-hero__button--secondary" href="{{ secondary_href }}">
              {{ st.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>

        {%- if st.note != blank -%}
          <p class="wholesale-hero__note">{{ st.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="wholesale-hero__media">
      {%- if hero_image != blank -%}
        <picture>
          {%- if st.hero_image_mobile != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ st.hero_image_mobile | image_url: width: 480 }} 480w,
                {{ st.hero_image_mobile | image_url: width: 750 }} 750w,
                {{ st.hero_image_mobile | image_url: width: 1000 }} 1000w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{-
            hero_image
            | image_url: width: 2000
            | image_tag:
              widths: '750, 1000, 1200, 1600, 2000',
              sizes: '(min-width: 990px) 72vw, 100vw',
              loading: 'eager',
              fetchpriority: 'high',
              alt: hero_alt,
              class: 'wholesale-hero__image'
          -}}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'wholesale-hero__placeholder' }}
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .wholesale-hero {
    background: var(--wholesale-hero-canvas, #f8f5f0);
    color: var(--wholesale-hero-text, #ffffff);
    overflow: hidden;
    padding: clamp(32px, 4vw, 64px) 0;
  }

  .wholesale-hero__grid {
    position: relative;
    isolation: isolate;
    min-height: var(--wholesale-hero-height, 680px);
    padding-left: 0;
    padding-right: 0;
  }

  .wholesale-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    width: min(calc(100% - 48px), var(--wholesale-hero-content-width, 660px));
    min-height: calc(var(--wholesale-hero-height, 680px) - 96px);
    margin: 48px 0 48px clamp(24px, 6vw, 96px);
    padding: clamp(48px, 5vw, 76px) var(--wholesale-hero-content-padding, 48px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: var(--wholesale-hero-bg, #1a3128);
  }

  .wholesale-hero__content-inner {
    width: 100%;
  }

  .wholesale-hero__eyebrow {
    margin: 0 0 18px;
    color: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .wholesale-hero__title {
    max-width: 100%;
    margin: 0;
    color: inherit;
    font-size: clamp(44px, 4vw, 68px);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.04;
  }

  .wholesale-hero__description {
    max-width: 590px;
    margin-top: 24px;
    color: inherit;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.65;
    opacity: 0.88;
  }

  .wholesale-hero__description p {
    margin: 0;
  }

  .wholesale-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .wholesale-hero__button {
    min-width: 190px;
    min-height: 52px;
    padding: 14px 24px;
    border: 1px solid var(--wholesale-hero-accent, #cfddc2);
    border-radius: 0;
    font-weight: 600;
    justify-content: center;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .wholesale-hero__button--primary {
    background: var(--wholesale-hero-accent, #cfddc2);
    color: #1a3128;
  }

  .wholesale-hero__button--secondary {
    background: transparent;
    color: var(--wholesale-hero-text, #ffffff);
  }

  .wholesale-hero__button--primary:hover,
  .wholesale-hero__button--primary:focus-visible {
    border-color: #ffffff;
    background: #ffffff;
    color: #1a3128;
  }

  .wholesale-hero__button--secondary:hover,
  .wholesale-hero__button--secondary:focus-visible {
    background: var(--wholesale-hero-text, #ffffff);
    color: #1a3128;
  }

  .wholesale-hero__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .wholesale-hero__note {
    margin: 18px 0 0;
    color: inherit;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.72;
  }

  .wholesale-hero__media {
    position: absolute;
    z-index: 1;
    inset: 0 0 0 calc(100% - var(--wholesale-hero-image-width, 72%));
    min-width: 0;
    overflow: hidden;
  }

  .wholesale-hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .wholesale-hero__image,
  .wholesale-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--wholesale-hero-image-position, center center);
  }

  .wholesale-hero__placeholder {
    background: #cfddc2;
  }

  @media (max-width: 989px) {
    .wholesale-hero {
      padding: 32px 0;
    }

    .wholesale-hero__grid {
      display: flex;
      flex-direction: column;
      min-height: 0;
      padding: 0 24px;
    }

    .wholesale-hero__content {
      width: min(100%, 680px);
      min-height: 0;
      margin: 0;
      padding: 60px clamp(28px, 6vw, 52px) 68px;
    }

    .wholesale-hero__media {
      position: relative;
      inset: auto;
      z-index: 1;
      width: calc(100% - 48px);
      min-height: 460px;
      margin: -28px 0 0 auto;
    }

    .wholesale-hero__image,
    .wholesale-hero__placeholder {
      min-height: 100%;
    }
  }

  @media (max-width: 575px) {
    .wholesale-hero {
      padding: 0;
    }

    .wholesale-hero__grid {
      padding: 0;
    }

    .wholesale-hero__content {
      width: 100%;
      padding: 56px var(--wholesale-hero-content-padding-mobile, 20px) 48px;
    }

    .wholesale-hero__actions {
      display: grid;
    }

    .wholesale-hero__button {
      width: 100%;
    }

    .wholesale-hero__media {
      width: 100%;
      min-height: 360px;
      margin: 0;
    }

    .wholesale-hero__image,
    .wholesale-hero__placeholder {
      min-height: 360px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale hero",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.all.layout.label",
      "default": "full-width",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "strecth-width",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "edge_to_edge_split",
      "label": "Full-bleed editorial layout",
      "info": "Keeps the panoramic image flush with the right edge. Turn off to use the section width above.",
      "default": true
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Text side padding (desktop)",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Text side padding (mobile)",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height (desktop)",
      "min": 560,
      "max": 840,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "image_width",
      "label": "Panoramic image width",
      "min": 60,
      "max": 85,
      "step": 1,
      "unit": "%",
      "default": 72
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text panel maximum width",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 660
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Matcharu Wholesale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Japanese Matcha for Cafés & Retailers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Ready to grow with bulk-ready formats, Japanese selection and personal support for your menu or shelves.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Bulk Formats"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "Defaults to #product-grid when left blank."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Request a Wholesale Quote"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "Defaults to #wholesale-inquiry when left blank."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Supporting note",
      "default": "Order available bulk packs directly or contact us for larger and recurring needs."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Image alt text",
      "default": "Japanese tea fields where Matcharu matcha is sourced"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Text panel color",
      "default": "#1A3128"
    },
    {
      "type": "color",
      "id": "canvas_color",
      "label": "Outer background color",
      "default": "#F8F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#CFDDC2"
    }
  ],
  "presets": [
    {
      "name": "Wholesale hero"
    }
  ]
}
{% endschema %}
