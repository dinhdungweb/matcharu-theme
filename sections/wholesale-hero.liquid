{%- liquid
  assign st = section.settings
  assign primary_href = st.primary_link
  assign secondary_href = st.secondary_link
  assign hero_image = st.hero_image | default: st.hero_image_mobile
  assign hero_image_mobile = st.hero_image_mobile | default: hero_image
  assign hero_container = st.container | default: 'full-width'
  assign content_padding = st.content_padding | default: 48
  assign content_padding_mobile = st.content_padding_mobile | default: 20
  assign hero_height = st.hero_height | default: 680
  assign hero_height_mobile = st.hero_height_mobile | default: 620
  assign content_width = st.content_width | default: 660
  assign image_position = st.image_position | default: 'center center'
  assign overlay_color = st.overlay_color | default: '#0d2a20'
  assign overlay_opacity = st.overlay_opacity | default: 90
  assign overlay_alpha = overlay_opacity | divided_by: 100.0
  assign heading_size = st.heading_size | default: 64
  assign content_vertical = st.content_vertical | default: 'center'

  if primary_href == blank
    assign primary_href = '#product-grid'
  endif
  if secondary_href == blank
    assign secondary_href = '#wholesale-inquiry'
  endif
-%}

<section
  class="wholesale-hero{% if hero_image != blank %} wholesale-hero--has-image{% endif %}"
  style="--wholesale-hero-bg: {{ st.background_color }}; --wholesale-hero-text: {{ st.text_color }}; --wholesale-hero-accent: {{ st.accent_color }}; --wholesale-hero-overlay: {{ overlay_color }}; --wholesale-hero-overlay-alpha: {{ overlay_alpha }}; --wholesale-hero-content-padding: {{ content_padding }}px; --wholesale-hero-content-padding-mobile: {{ content_padding_mobile }}px; --wholesale-hero-height: {{ hero_height }}px; --wholesale-hero-height-mobile: {{ hero_height_mobile }}px; --wholesale-hero-content-width: {{ content_width }}px; --wholesale-hero-heading-size: {{ heading_size }}px; --wholesale-hero-content-vertical: {{ content_vertical }}; --wholesale-hero-image-position: {{ image_position }};{% if hero_image != blank %} --wholesale-hero-image: url('{{ hero_image | image_url: width: 2400 }}'); --wholesale-hero-image-mobile: url('{{ hero_image_mobile | image_url: width: 1200 }}');{% endif %}"
  aria-labelledby="WholesaleHeroTitle-{{ section.id }}"
>
  {%- if hero_image == blank -%}
    <div class="wholesale-hero__media">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'wholesale-hero__placeholder' }}
    </div>
  {%- endif -%}

  <div class="{{ hero_container }} section-full wholesale-hero__grid">
    <div class="wholesale-hero__content">
      <div class="wholesale-hero__content-inner">
        {%- if st.eyebrow != blank -%}
          <p class="wholesale-hero__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}

        {%- if st.heading != blank -%}
          <h1 id="WholesaleHeroTitle-{{ section.id }}" class="wholesale-hero__title">
            {{ st.heading | escape }}
          </h1>
        {%- endif -%}

        {%- if st.description != blank -%}
          <div class="wholesale-hero__description rte">{{ st.description }}</div>
        {%- endif -%}

        <div class="wholesale-hero__actions">
          {%- if st.primary_label != blank -%}
            <a class="button wholesale-hero__button wholesale-hero__button--primary" href="{{ primary_href }}">
              {{ st.primary_label | escape }}
            </a>
          {%- endif -%}
          {%- if st.secondary_label != blank -%}
            <a class="button wholesale-hero__button wholesale-hero__button--secondary" href="{{ secondary_href }}">
              {{ st.secondary_label | escape }}
            </a>
          {%- endif -%}
        </div>

        {%- if st.note != blank -%}
          <p class="wholesale-hero__note">{{ st.note | escape }}</p>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .wholesale-hero {
    position: relative;
    isolation: isolate;
    min-height: var(--wholesale-hero-height, 680px);
    background-color: var(--wholesale-hero-bg, #1a3128);
    background-position: var(--wholesale-hero-image-position, center center);
    background-repeat: no-repeat;
    background-size: cover;
    color: var(--wholesale-hero-text, #ffffff);
    overflow: hidden;
    margin: 0;
    padding: 0 !important;
  }

  .wholesale-hero--has-image {
    background-image: var(--wholesale-hero-image);
  }

  .wholesale-hero__grid {
    position: relative;
    z-index: 2;
    min-height: var(--wholesale-hero-height, 680px);
  }

  .wholesale-hero__grid.full-width {
    padding-right: var(--wholesale-hero-content-padding, 48px);
    padding-left: var(--wholesale-hero-content-padding, 48px);
  }

  .wholesale-hero::after {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      90deg,
      var(--wholesale-hero-overlay, #0d2a20) 0%,
      var(--wholesale-hero-overlay, #0d2a20) 28%,
      transparent 78%
    );
    opacity: var(--wholesale-hero-overlay-alpha, 0.88);
    pointer-events: none;
  }

  .wholesale-hero__content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: var(--wholesale-hero-content-vertical, center);
    box-sizing: border-box;
    width: min(100%, var(--wholesale-hero-content-width, 660px));
    min-height: var(--wholesale-hero-height, 680px);
    margin-left: 0;
    padding: clamp(64px, 8vw, 120px) 0;
  }

  .wholesale-hero__content-inner {
    width: 100%;
  }

  .wholesale-hero__eyebrow {
    margin: 0 0 18px;
    color: inherit;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .wholesale-hero__title {
    max-width: 100%;
    margin: 0;
    color: inherit;
    font-size: clamp(42px, 4.2vw, var(--wholesale-hero-heading-size, 64px));
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.04;
    text-wrap: balance;
  }

  .wholesale-hero__description {
    max-width: 590px;
    margin-top: 24px;
    color: inherit;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.65;
    opacity: 0.88;
  }

  .wholesale-hero__description p {
    margin: 0;
  }

  .wholesale-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .wholesale-hero__button {
    min-width: 190px;
    min-height: 52px;
    padding: 14px 24px;
    border: 1px solid var(--wholesale-hero-accent, #cfddc2);
    border-radius: 0;
    font-weight: 600;
    justify-content: center;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease;
  }

  .wholesale-hero__button--primary {
    background: var(--wholesale-hero-accent, #cfddc2);
    color: #1a3128;
  }

  .wholesale-hero__button--secondary {
    background: transparent;
    color: var(--wholesale-hero-text, #ffffff);
  }

  .wholesale-hero__button--primary:hover,
  .wholesale-hero__button--primary:focus-visible {
    border-color: #ffffff;
    background: #ffffff;
    color: #1a3128;
  }

  .wholesale-hero__button--secondary:hover,
  .wholesale-hero__button--secondary:focus-visible {
    background: var(--wholesale-hero-text, #ffffff);
    color: #1a3128;
  }

  .wholesale-hero__button:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 3px;
  }

  .wholesale-hero__note {
    margin: 18px 0 0;
    color: inherit;
    font-size: 13px;
    line-height: 1.5;
    opacity: 0.72;
  }

  .wholesale-hero__media {
    position: absolute;
    z-index: 0;
    inset: 0 !important;
    min-width: 0;
    overflow: hidden;
  }

  .wholesale-hero__media picture {
    position: absolute;
    inset: 0;
    display: block;
  }

  .wholesale-hero__image,
  .wholesale-hero__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--wholesale-hero-image-position, center center);
  }

  .wholesale-hero__placeholder {
    background: #cfddc2;
  }

  @media (max-width: 989px) {
    .wholesale-hero {
      min-height: var(--wholesale-hero-height-mobile, 620px);
    }

    .wholesale-hero__grid {
      min-height: var(--wholesale-hero-height-mobile, 620px);
    }

    .wholesale-hero::after {
      background: linear-gradient(
        90deg,
        var(--wholesale-hero-overlay, #0d2a20) 0%,
        var(--wholesale-hero-overlay, #0d2a20) 32%,
        transparent 100%
      );
    }

    .wholesale-hero__content {
      width: min(78%, 620px);
      min-height: var(--wholesale-hero-height-mobile, 620px);
      margin: 0;
      padding: 64px 0;
    }
  }

  @media (max-width: 749px) {
    .wholesale-hero--has-image {
      background-image: var(--wholesale-hero-image-mobile, var(--wholesale-hero-image));
    }
  }

  @media (max-width: 575px) {
    .wholesale-hero__grid.full-width {
      padding-right: var(--wholesale-hero-content-padding-mobile, 20px);
      padding-left: var(--wholesale-hero-content-padding-mobile, 20px);
    }

    .wholesale-hero__grid {
      min-height: var(--wholesale-hero-height-mobile, 620px);
    }

    .wholesale-hero::after {
      background: linear-gradient(
        180deg,
        var(--wholesale-hero-overlay, #0d2a20) 0%,
        var(--wholesale-hero-overlay, #0d2a20) 48%,
        transparent 112%
      );
    }

    .wholesale-hero__content {
      width: 100%;
      min-height: var(--wholesale-hero-height-mobile, 620px);
      justify-content: flex-start;
      padding: 64px 0 48px;
    }

    .wholesale-hero__actions {
      display: grid;
    }

    .wholesale-hero__button {
      width: 100%;
    }

    .wholesale-hero__description {
      max-width: 440px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale hero",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Content layout",
      "info": "Controls the content width only. The hero background always remains full width.",
      "default": "full-width",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "strecth-width",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ]
    },
    {
      "type": "range",
      "id": "content_padding",
      "label": "Full-width content padding (desktop)",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "content_padding_mobile",
      "label": "Full-width content padding (mobile)",
      "min": 12,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Hero height (desktop)",
      "min": 560,
      "max": 840,
      "step": 20,
      "unit": "px",
      "default": 680
    },
    {
      "type": "range",
      "id": "hero_height_mobile",
      "label": "Hero height (mobile)",
      "min": 480,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 620
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "Text panel maximum width",
      "min": 520,
      "max": 760,
      "step": 20,
      "unit": "px",
      "default": 660
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading maximum size",
      "min": 44,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "select",
      "id": "content_vertical",
      "label": "Text vertical position",
      "default": "center",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal position",
      "default": "center center",
      "options": [
        {
          "value": "left center",
          "label": "Left"
        },
        {
          "value": "center center",
          "label": "Center"
        },
        {
          "value": "right center",
          "label": "Right"
        },
        {
          "value": "center top",
          "label": "Top"
        },
        {
          "value": "center bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Matcharu Wholesale"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Japanese Matcha for Cafés & Retailers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Ready to grow with bulk-ready formats, Japanese selection and personal support for your menu or shelves.</p>"
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop Bulk Formats"
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary button link",
      "info": "Defaults to #product-grid when left blank."
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Request a Wholesale Quote"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary button link",
      "info": "Defaults to #wholesale-inquiry when left blank."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Supporting note",
      "default": "Order available bulk packs directly or contact us for larger and recurring needs."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Desktop image"
    },
    {
      "type": "image_picker",
      "id": "hero_image_mobile",
      "label": "Mobile image"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Image alt text",
      "default": "Japanese tea fields where Matcharu matcha is sourced"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Fallback background color",
      "default": "#1A3128"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Text overlay color",
      "default": "#0D2A20"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Text overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#CFDDC2"
    }
  ],
  "presets": [
    {
      "name": "Wholesale hero"
    }
  ]
}
{% endschema %}
