{%- liquid
  assign st = section.settings
  assign form_id = 'WholesaleContactForm-' | append: section.id
  assign form_image_alt = st.form_image_alt | default: st.heading
-%}

<section
  id="wholesale-inquiry"
  class="wholesale-inquiry"
  style="--wholesale-inquiry-bg: {{ st.background_color }}; --wholesale-inquiry-panel: {{ st.panel_color }}; --wholesale-inquiry-text: {{ st.text_color }}; --wholesale-inquiry-accent: {{ st.accent_color }}; --wholesale-inquiry-padding-top: {{ st.padding_top }}px; --wholesale-inquiry-padding-bottom: {{ st.padding_bottom }}px;"
  aria-labelledby="WholesaleInquiryTitle-{{ section.id }}"
>
  <div class="{{ st.container }} section-full wholesale-inquiry__grid">
    <div class="wholesale-inquiry__intro">
      {%- if st.form_image != blank -%}
        <div class="wholesale-inquiry__media">
          {{-
            st.form_image
            | image_url: width: 1200
            | image_tag:
              widths: '480, 750, 900, 1200',
              sizes: '(min-width: 990px) 42vw, 100vw',
              loading: 'lazy',
              alt: form_image_alt,
              class: 'wholesale-inquiry__image'
          -}}
        </div>
      {%- endif -%}

      <div class="wholesale-inquiry__intro-content">
        {%- if st.eyebrow != blank -%}
          <p class="wholesale-section__eyebrow">{{ st.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 id="WholesaleInquiryTitle-{{ section.id }}" class="wholesale-inquiry__title">
          {{ st.heading | escape }}
        </h2>
        {%- if st.description != blank -%}
          <div id="WholesaleInquiryDescription-{{ section.id }}" class="wholesale-inquiry__description rte">
            {{ st.description }}
          </div>
        {%- endif -%}
        {%- if st.contact_note != blank -%}
          <p class="wholesale-inquiry__contact-note">{{ st.contact_note | escape }}</p>
        {%- endif -%}
      </div>
    </div>

    <div class="wholesale-inquiry__form-panel">
      {%- form 'contact', id: form_id, class: 'wholesale-inquiry__form' -%}
        <input type="hidden" name="contact[request_type]" value="Wholesale inquiry">

        {%- if form.posted_successfully? -%}
          <div class="wholesale-inquiry__message wholesale-inquiry__message--success" role="status" tabindex="-1">
            {{ st.success_message | escape }}
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="wholesale-inquiry__message wholesale-inquiry__message--error" role="alert" tabindex="-1">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="wholesale-inquiry__fields">
          <div class="wholesale-inquiry__field">
            <label for="WholesaleName-{{ section.id }}">
              {{ st.name_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="WholesaleName-{{ section.id }}"
              class="form-input"
              type="text"
              name="contact[name]"
              value="{{ form.name | default: customer.name | escape }}"
              autocomplete="name"
              required
            >
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleEmail-{{ section.id }}">
              {{ st.email_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="WholesaleEmail-{{ section.id }}"
              class="form-input"
              type="email"
              name="contact[email]"
              value="{{ form.email | default: customer.email | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleCompany-{{ section.id }}">
              {{ st.company_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="WholesaleCompany-{{ section.id }}"
              class="form-input"
              type="text"
              name="contact[company]"
              value="{{ form.company | escape }}"
              autocomplete="organization"
              required
            >
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesalePhone-{{ section.id }}">{{ st.phone_label | escape }}</label>
            <input
              id="WholesalePhone-{{ section.id }}"
              class="form-input"
              type="tel"
              name="contact[phone]"
              value="{{ form.phone | default: customer.phone | escape }}"
              autocomplete="tel"
            >
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleBusinessType-{{ section.id }}">
              {{ st.business_type_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <select
              id="WholesaleBusinessType-{{ section.id }}"
              class="form-input"
              name="contact[business_type]"
              required
            >
              <option value="" disabled {% if form.business_type == blank %}selected{% endif %}>Select one</option>
              <option value="Cafe or coffee shop" {% if form.business_type == 'Cafe or coffee shop' %}selected{% endif %}>Café / Coffee shop</option>
              <option value="Restaurant or food service" {% if form.business_type == 'Restaurant or food service' %}selected{% endif %}>Restaurant / Food service</option>
              <option value="Retailer" {% if form.business_type == 'Retailer' %}selected{% endif %}>Retailer</option>
              <option value="Distributor" {% if form.business_type == 'Distributor' %}selected{% endif %}>Distributor</option>
              <option value="Other" {% if form.business_type == 'Other' %}selected{% endif %}>Other</option>
            </select>
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleCountry-{{ section.id }}">
              {{ st.country_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="WholesaleCountry-{{ section.id }}"
              class="form-input"
              type="text"
              name="contact[country]"
              value="{{ form.country | escape }}"
              autocomplete="country-name"
              required
            >
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleProductInterest-{{ section.id }}">
              {{ st.product_interest_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <select
              id="WholesaleProductInterest-{{ section.id }}"
              class="form-input"
              name="contact[product_interest]"
              required
            >
              <option value="" disabled {% if form.product_interest == blank %}selected{% endif %}>Select one</option>
              <option value="Matcha" {% if form.product_interest == 'Matcha' %}selected{% endif %}>Matcha</option>
              <option value="Hojicha" {% if form.product_interest == 'Hojicha' %}selected{% endif %}>Hojicha</option>
              <option value="Matcha and Hojicha" {% if form.product_interest == 'Matcha and Hojicha' %}selected{% endif %}>Both</option>
              <option value="Samples" {% if form.product_interest == 'Samples' %}selected{% endif %}>Samples</option>
              <option value="Other" {% if form.product_interest == 'Other' %}selected{% endif %}>Other</option>
            </select>
          </div>

          <div class="wholesale-inquiry__field">
            <label for="WholesaleVolume-{{ section.id }}">
              {{ st.volume_label | escape }} <span aria-hidden="true">*</span>
            </label>
            <input
              id="WholesaleVolume-{{ section.id }}"
              class="form-input"
              type="text"
              name="contact[estimated_monthly_volume]"
              value="{{ form.estimated_monthly_volume | escape }}"
              placeholder="For example: 5 kg per month"
              required
            >
          </div>

          <div class="wholesale-inquiry__field wholesale-inquiry__field--full">
            <label for="WholesaleMessage-{{ section.id }}">{{ st.message_label | escape }}</label>
            <textarea
              id="WholesaleMessage-{{ section.id }}"
              class="form-input"
              name="contact[body]"
              rows="6"
            >{{ form.body | escape }}</textarea>
          </div>
        </div>

        <div class="wholesale-inquiry__actions">
          <button class="button wholesale-inquiry__submit" type="submit">
            {{ st.submit_label | escape }}
          </button>
          {%- if st.submit_note != blank -%}
            <p>{{ st.submit_note | escape }}</p>
          {%- endif -%}
        </div>
      {%- endform -%}
    </div>
  </div>
</section>

{% stylesheet %}
  html {
    scroll-behavior: smooth;
  }

  .wholesale-inquiry {
    background: var(--wholesale-inquiry-bg, #1a3128);
    color: var(--wholesale-inquiry-text, #ffffff);
    padding-top: var(--wholesale-inquiry-padding-top, 96px);
    padding-bottom: var(--wholesale-inquiry-padding-bottom, 96px);
    scroll-margin-top: 90px;
  }

  .wholesale-inquiry__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    align-items: start;
    gap: clamp(44px, 7vw, 104px);
  }

  .wholesale-inquiry__media {
    margin-bottom: 42px;
    overflow: hidden;
  }

  .wholesale-inquiry__image {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .wholesale-inquiry .wholesale-section__eyebrow,
  .wholesale-inquiry__title,
  .wholesale-inquiry__description,
  .wholesale-inquiry__contact-note {
    color: var(--wholesale-inquiry-text, #ffffff);
  }

  .wholesale-inquiry .wholesale-section__eyebrow {
    margin: 0 0 18px;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.18em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .wholesale-inquiry__title {
    margin: 0;
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1.08;
  }

  .wholesale-inquiry__description {
    margin-top: 22px;
    font-size: 16px;
    line-height: 1.75;
    opacity: 0.82;
  }

  .wholesale-inquiry__description p {
    margin: 0;
  }

  .wholesale-inquiry__contact-note {
    margin: 24px 0 0;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    font-size: 14px;
    line-height: 1.6;
  }

  .wholesale-inquiry__form-panel {
    padding: clamp(28px, 5vw, 58px);
    background: var(--wholesale-inquiry-panel, #f8f5f0);
    color: #1a3128;
  }

  .wholesale-inquiry__fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px 18px;
  }

  .wholesale-inquiry__field {
    min-width: 0;
  }

  .wholesale-inquiry__field--full {
    grid-column: 1 / -1;
  }

  .wholesale-inquiry__field label {
    display: block;
    margin-bottom: 9px;
    color: #1a3128;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.4;
  }

  .wholesale-inquiry__field .form-input {
    width: 100%;
    min-height: 50px;
    margin: 0;
    padding: 12px 14px;
    border: 1px solid rgba(26, 49, 40, 0.58);
    border-radius: 0;
    background: #ffffff;
    color: #1a3128;
    font: inherit;
  }

  .wholesale-inquiry__field textarea.form-input {
    min-height: 150px;
    resize: vertical;
  }

  .wholesale-inquiry__field .form-input:focus-visible {
    border-color: #1a3128;
    outline: 2px solid var(--wholesale-inquiry-accent, #cfddc2);
    outline-offset: 1px;
  }

  .wholesale-inquiry__message {
    margin-bottom: 26px;
    padding: 16px 18px;
    border: 1px solid currentColor;
    font-size: 14px;
    line-height: 1.6;
  }

  .wholesale-inquiry__message--success {
    background: #e3eddb;
    color: #1a3128;
  }

  .wholesale-inquiry__message--error {
    background: #fff1ef;
    color: #8f241a;
  }

  .wholesale-inquiry__message ul {
    margin: 8px 0 0;
    padding-left: 18px;
  }

  .wholesale-inquiry__actions {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-top: 28px;
  }

  .wholesale-inquiry__submit {
    flex: 0 0 auto;
    min-height: 52px;
    padding: 14px 28px;
    border: 1px solid #1a3128;
    border-radius: 0;
    background: #1a3128;
    color: #ffffff;
    font-weight: 600;
  }

  .wholesale-inquiry__submit:hover,
  .wholesale-inquiry__submit:focus-visible {
    border-color: #000000;
    background: #000000;
    color: #ffffff;
  }

  .wholesale-inquiry__submit:focus-visible {
    outline: 2px solid #1a3128;
    outline-offset: 3px;
  }

  .wholesale-inquiry__actions p {
    margin: 0;
    color: #1a3128;
    font-size: 12px;
    line-height: 1.5;
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }

  @media (max-width: 989px) {
    .wholesale-inquiry__grid {
      grid-template-columns: 1fr;
    }

    .wholesale-inquiry__intro {
      max-width: 760px;
    }
  }

  @media (max-width: 749px) {
    .wholesale-inquiry {
      padding-top: min(var(--wholesale-inquiry-padding-top, 96px), 64px);
      padding-bottom: min(var(--wholesale-inquiry-padding-bottom, 96px), 64px);
    }

    .wholesale-inquiry__fields {
      grid-template-columns: 1fr;
    }

    .wholesale-inquiry__field--full {
      grid-column: auto;
    }

    .wholesale-inquiry__form-panel {
      padding: 28px 20px;
    }

    .wholesale-inquiry__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .wholesale-inquiry__submit {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Wholesale inquiry",
  "disabled_on": {
    "groups": ["header", "footer", "custom.overlay"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "t:sections.all.layout.label",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "t:sections.all.layout.options__1.label"
        },
        {
          "value": "container-fluid",
          "label": "t:sections.all.layout.options__2.label"
        },
        {
          "value": "strecth-width",
          "label": "t:sections.all.layout.options__3.label"
        },
        {
          "value": "full-width",
          "label": "t:sections.all.layout.options__4.label"
        }
      ]
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Request a wholesale quote"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tell us what your business needs"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share your product interests, expected volume and destination. We will use those details to discuss the most suitable next step.</p>"
    },
    {
      "type": "text",
      "id": "contact_note",
      "label": "Contact note",
      "default": "Prefer email? Contact matcharuus@gmail.com"
    },
    {
      "type": "image_picker",
      "id": "form_image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "form_image_alt",
      "label": "Image alt text",
      "default": "Matcharu matcha prepared for wholesale customers"
    },
    {
      "type": "header",
      "content": "Form labels"
    },
    {
      "type": "text",
      "id": "name_label",
      "label": "Name label",
      "default": "Name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Business email"
    },
    {
      "type": "text",
      "id": "company_label",
      "label": "Company label",
      "default": "Company"
    },
    {
      "type": "text",
      "id": "phone_label",
      "label": "Phone label",
      "default": "Phone (optional)"
    },
    {
      "type": "text",
      "id": "business_type_label",
      "label": "Business type label",
      "default": "Business type"
    },
    {
      "type": "text",
      "id": "country_label",
      "label": "Country label",
      "default": "Country / region"
    },
    {
      "type": "text",
      "id": "product_interest_label",
      "label": "Product interest label",
      "default": "Product interest"
    },
    {
      "type": "text",
      "id": "volume_label",
      "label": "Volume label",
      "default": "Estimated monthly volume"
    },
    {
      "type": "text",
      "id": "message_label",
      "label": "Message label",
      "default": "Additional details (optional)"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button label",
      "default": "Request a Wholesale Quote"
    },
    {
      "type": "text",
      "id": "submit_note",
      "label": "Submit note",
      "default": "Submitting this form does not commit you to an order."
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thank you. Your wholesale inquiry has been sent."
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#1A3128"
    },
    {
      "type": "color",
      "id": "panel_color",
      "label": "Form panel color",
      "default": "#F8F5F0"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Intro text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Focus accent color",
      "default": "#CFDDC2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ],
  "presets": [
    {
      "name": "Wholesale inquiry"
    }
  ]
}
{% endschema %}
